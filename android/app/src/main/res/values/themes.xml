        <item name="android:colorPrimary">#27AE60</item>
        <item name="android:colorPrimaryDark">#27AE60</item>
        <item name="android:colorAccent">#27AE60</item>
        <item name="android:statusBarColor">#27AE60</item>
        <item name="android:windowBackground">@android:color/white</item>
    </style>
</resources>
