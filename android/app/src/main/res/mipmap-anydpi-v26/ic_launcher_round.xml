<?xml version="1.0" encoding="utf-8"?>
<!-- The site's icon is full-bleed with the face inside the middle 59%, which
     is inside an adaptive icon's safe zone (61%), so the whole picture is the
     background layer and nothing is cropped whatever shape the launcher uses. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@android:color/transparent" />
</adaptive-icon>
