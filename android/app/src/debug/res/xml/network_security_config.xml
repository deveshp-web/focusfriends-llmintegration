<?xml version="1.0" encoding="utf-8"?>
<!-- DEBUG BUILDS ONLY: let the emulator load a copy of the site served from
     this computer over plain http (10.0.2.2 is the computer, seen from the
     emulator). Release builds allow https only. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
