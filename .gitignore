# Written as UTF-8. The previous version of this file was UTF-16LE with a BOM,
# which git cannot parse - every rule in it was silently ignored.
__pycache__/
*.pyc

# Intermediates from the "previous run" the change feed compares against.
# insights_prev.jsonl and insights_meta_prev.json are NOT ignored: notify.py
# reads them, so keeping them committed means a fresh clone can render the
# "since your last check" panel without a two-minute detector run first.
flagged_by_classroom_prev.jsonl
judge_cases_prev.jsonl
recommendations_prev.jsonl
classroom_actions_prev.jsonl
recommendations_meta_prev.json

# Single-room dashboards are throwaway views of committed data.
demo_room.html

# macOS directory metadata, which arrives with any file copied off a Mac.
.DS_Store

# Local teacher review state, not pipeline output. It accumulates as people use
# review_flags.py or the Streamlit viewer, and can carry names and free-text
# notes, so it stays on the machine that produced it.
flag_reviews.jsonl

# Optional LLM gloss from generate_insights.py. It needs a local Ollama model to
# reproduce, so committing it would put an artefact in the tree that a fresh
# clone cannot regenerate.
insights_with_suggestions.jsonl
